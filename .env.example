APP_NAME=Spendula
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=spendula_dev
DB_USERNAME=spendula
DB_PASSWORD=spendula

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log

# ---------------------------------------------------------------------------
# Spendula
# ---------------------------------------------------------------------------
# Enable Banking (PSD2 provider)
SPENDULA_ENABLE_BANKING_APP_ID=
SPENDULA_ENABLE_BANKING_PRIVATE_KEY_PATH=storage/keys/enablebanking.key
SPENDULA_ENABLE_BANKING_ENV=sandbox

# YNAB (destination of record)
SPENDULA_YNAB_ACCESS_TOKEN=
SPENDULA_YNAB_PLAN_ID=

# Base currency (must match the YNAB plan's currency; expected: EUR)
SPENDULA_BASE_CURRENCY=EUR

# Exchange rate provider (phase 3+): ecb, frankfurter, exchangerate-host
SPENDULA_EXCHANGE_RATE_PROVIDER=frankfurter
# Override the provider's base URL (defaults to Frankfurter's public API).
#SPENDULA_EXCHANGE_RATE_BASE_URL=https://api.frankfurter.dev/v1

# OAuth callback URL
# Local dev (php artisan serve): http://localhost:8000/banking/callback
# Production:                    https://spendula.example.com/banking/callback
SPENDULA_CALLBACK_URL=http://localhost:8000/banking/callback

# Auto-decision rule denylist (GH #39): comma-separated names that
# should never become a payee_rules entry on first decision. Use this
# for names that legitimately resolve to multiple verdicts (e.g. your
# own legal name appears as both ATM withdrawals AND self-transfers).
# Compared case-insensitively against the cleaned counterparty_name.
SPENDULA_OPERATOR_NAMES=

# Synthetic counterparty label for ATM cash withdrawals (GH #42).
# Used by the Resolver short-circuit: when bank_transaction_code.code
# is "ATM" and credit_debit_indicator is "DBIT", the resolver returns
# this label at level 1 instead of falling through to the cardholder's
# own name. Default "ATM Cash" if unset.
SPENDULA_ATM_CASH_LABEL=

# Own-account transfer classifier prefix (GH #14).
# Both same-currency and cross-currency (FX) own-account moves resolve to a
# transfer (see DECISIONS.md — GH #14 FX-as-transfer reversal). The full
# counterparty_name becomes "<prefix> : <destination display_name>".
# Default "Transfer" if unset.
SPENDULA_OWN_ACCOUNT_TRANSFER_PREFIX=
